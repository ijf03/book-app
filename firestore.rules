rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function collectionAllowed(kind) {
      return kind in ['books', 'sessions', 'notes', 'reviews', 'goals', 'lists', 'preferences'];
    }
    function optionalString(data, key, limit) {
      return !(key in data) || (data[key] is string && data[key].size() <= limit);
    }
    function optionalNumber(data, key) {
      return !(key in data) || data[key] is number;
    }
    function optionalPositiveInt(data, key) {
      return !(key in data) || (data[key] is int && data[key] >= 0);
    }
    function progress(data) {
      return data is map && data.keys().hasOnly(['page', 'percentage', 'timestampSeconds'])
        && optionalPositiveInt(data, 'page') && optionalPositiveInt(data, 'timestampSeconds')
        && (!('percentage' in data) || (data.percentage is number && data.percentage >= 0 && data.percentage <= 100));
    }
    function book(data, id) {
      return data.keys().hasAll(['id', 'title', 'authors', 'status', 'format', 'progress'])
        && data.keys().hasOnly(['id', 'title', 'authors', 'description', 'coverURL', 'pageCount', 'status', 'format', 'sourceBookID', 'completedAt', 'progress', 'genre', 'bookType', 'language', 'pastReads', 'currentReadID', 'currentReadStartedAt'])
        && data.id == id && data.title is string && data.title.size() <= 10000
        && data.authors is list && data.authors.size() <= 1000
        && data.status in ['reading', 'toRead', 'completed']
        && data.format in ['physical', 'ebook', 'audiobook', 'immersive'] && progress(data.progress)
        && optionalString(data, 'description', 700000) && optionalString(data, 'coverURL', 8192)
        && optionalString(data, 'sourceBookID', 4096) && optionalPositiveInt(data, 'pageCount')
        && optionalNumber(data, 'completedAt') && optionalString(data, 'genre', 100)
        && optionalString(data, 'language', 100)
        && optionalString(data, 'currentReadID', 100) && optionalNumber(data, 'currentReadStartedAt')
        && (!('pastReads' in data) || (data.pastReads is list && data.pastReads.size() <= 10000))
        && (!('bookType' in data) || data.bookType in ['fiction', 'nonfiction']);
    }
    function session(data, id) {
      return data.keys().hasAll(['id', 'bookID', 'startedAt', 'totalPausedSeconds', 'startProgress'])
        && data.keys().hasOnly(['id', 'bookID', 'startedAt', 'endedAt', 'pausedAt', 'totalPausedSeconds', 'startProgress', 'endProgress', 'readID'])
        && data.id == id && data.bookID is string && data.bookID.size() > 0 && data.bookID.size() <= 4096
        && optionalString(data, 'readID', 100)
        && data.startedAt is number && optionalNumber(data, 'endedAt') && optionalNumber(data, 'pausedAt')
        && data.totalPausedSeconds is int && data.totalPausedSeconds >= 0 && progress(data.startProgress)
        && (!('endProgress' in data) || progress(data.endProgress));
    }
    function note(data, id) {
      return data.keys().hasAll(['id', 'bookID', 'text', 'containsSpoilers', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'bookID', 'text', 'page', 'containsSpoilers', 'createdAt', 'updatedAt'])
        && data.id == id && data.bookID is string && data.bookID.size() > 0 && data.bookID.size() <= 4096
        && data.text is string && data.text.size() <= 700000 && optionalPositiveInt(data, 'page')
        && data.containsSpoilers is bool && data.createdAt is number && data.updatedAt is number;
    }
    function review(data, id) {
      return data.keys().hasAll(['id', 'bookID', 'rating', 'text', 'containsSpoilers', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'bookID', 'rating', 'text', 'containsSpoilers', 'createdAt', 'updatedAt', 'mood'])
        && optionalString(data, 'mood', 100)
        && data.id is string && data.id.size() == 36 && data.bookID == id
        && data.rating is int && data.rating >= 1 && data.rating <= 5
        && data.text is string && data.text.size() <= 700000
        && data.containsSpoilers is bool && data.createdAt is number && data.updatedAt is number;
    }
    function goal(data, id) {
      return data.keys().hasAll(['year', 'target'])
        && data.keys().hasOnly(['year', 'target', 'period', 'metric', 'periodKey'])
        && data.year is int && data.year >= 1 && data.year <= 9999
        && data.target is int && data.target >= 1 && data.target <= 10000
        && ((!('period' in data) && !('metric' in data) && !('periodKey' in data) && string(data.year) == id)
          || (data.keys().hasAll(['period', 'metric', 'periodKey'])
            && data.period in ['year', 'month', 'week'] && data.metric in ['books', 'pages', 'days']
            && data.periodKey is string && data.periodKey.matches('^[0-9]{1,4}-[0-9]{1,2}-[0-9]{1,2}$')
            && ((data.period == 'year' && data.metric == 'books' && string(data.year) == id)
              || (!(data.period == 'year' && data.metric == 'books') && id == data.period + '-' + data.metric + '-' + data.periodKey))));
    }
    function customList(data, id) {
      return data.keys().hasAll(['id', 'name', 'description', 'bookIDs'])
        && data.keys().hasOnly(['id', 'name', 'description', 'bookIDs']) && data.id == id
        && data.name is string && data.name.size() > 0 && data.name.size() <= 10000
        && data.description is string && data.description.size() <= 700000
        && data.bookIDs is list && data.bookIDs.size() <= 10000;
    }
    function preferences(data, id) {
      return (id.matches('^checkIn-[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && data.keys().hasAll(['day', 'didRead', 'recordedAt'])
          && data.keys().hasOnly(['day', 'didRead', 'recordedAt'])
          && data.day is string && data.day.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
          && id == 'checkIn-' + data.day && data.didRead is bool && data.recordedAt is number)
        || (id == 'reminders'  && data.keys().hasAll(['isEnabled', 'hour', 'minute'])
          && data.keys().hasOnly(['isEnabled', 'hour', 'minute']) && data.isEnabled is bool
          && data.hour is int && data.hour >= 0 && data.hour <= 23
          && data.minute is int && data.minute >= 0 && data.minute <= 59)
        || (id in ['bookOrder', 'listOrder'] && data.keys().hasAll(['ids'])
          && data.keys().hasOnly(['ids']) && data.ids is list && data.ids.size() <= 10000);
    }
    function payload(kind, data, id) {
      return (kind == 'books' && book(data, id))
        || (kind == 'sessions' && session(data, id))
        || (kind == 'notes' && note(data, id))
        || (kind == 'reviews' && review(data, id))
        || (kind == 'goals' && goal(data, id))
        || (kind == 'lists' && customList(data, id))
        || (kind == 'preferences' && preferences(data, id));
    }
    function valid(kind, documentID) {
      let value = request.resource.data;
      return value.keys().hasAll(['schemaVersion', 'entityID', 'revision', 'operationID', 'deleted', 'data', 'updatedAt'])
        && value.keys().hasOnly(['schemaVersion', 'entityID', 'revision', 'operationID', 'deleted', 'data', 'updatedAt'])
        && documentID.matches('^[0-9a-f]{64}$')
        && value.schemaVersion == 1 && value.schemaVersion is int
        && value.entityID is string && value.entityID.size() > 0 && value.entityID.size() <= 4096
        && value.revision is int && value.revision > 0
        && value.operationID is string && value.operationID.size() == 36
        && value.deleted is bool && value.data is map
        && value.updatedAt is timestamp && value.updatedAt == request.time
        && ((value.deleted && value.data.keys().size() == 0) || (!value.deleted && payload(kind, value.data, value.entityID)));
    }
    match /users/{uid}/{kind}/{documentID} {
      allow read: if owner(uid) && collectionAllowed(kind);
      allow create: if owner(uid) && collectionAllowed(kind) && valid(kind, documentID)
        && request.resource.data.revision == 1;
      allow update: if owner(uid) && collectionAllowed(kind) && valid(kind, documentID)
        && request.resource.data.entityID == resource.data.entityID
        && request.resource.data.revision == resource.data.revision + 1;
      // Deletions are revisioned tombstones. Physical deletion would allow stale resurrection.
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
